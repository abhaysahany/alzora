# WalletConnect Project ID for RainbowKit / Wagmi
# Obtain your project ID from https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Optional AI Assistant Configuration (Sentinel Guard AI & Plan Explainer Voice AI)
# Works out of the box with zero-downtime local ELZORA extraction engine if omitted
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_AI_API_BASE=
